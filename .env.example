DB_URL=postgresql+asyncpg://contacts:contacts@localhost:5432/contacts
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
PASSWORD_RESET_EXPIRATION_SECONDS=900
REDIS_URL=redis://localhost:6379/0

MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=replace-with-mail-from
MAIL_PORT=465
MAIL_SERVER=replace-with-mail-server
MAIL_FROM_NAME=Contacts API

